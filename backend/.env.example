# Anthropic — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Optional — MongoDB database name (defaults to "buffbites")
APP_NAME=buffbites

# Optional — port for uvicorn (defaults to 8000)
PORT=8000

# Optional but recommended — comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow all origins (logs a warning). *.vercel.app is always allowed.
# Example: ALLOWED_ORIGINS=https://buffbites.app,http://localhost:3000
ALLOWED_ORIGINS=

# Firebase service account credentials (production / Docker)
# Paste the full contents of serviceAccountKey.json as a single-line JSON string.
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Locally you can leave this unset and use serviceAccountKey.json instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — Strava link for the fuel coach. Leave unset to hide the feature.
# Create an API app at https://www.strava.com/settings/api and set its
# "Authorization Callback Domain" to your frontend's domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Where Strava sends students back after they approve, on the frontend:
# https://<your-frontend>/strava/callback (http://localhost:3000/strava/callback locally)
STRAVA_REDIRECT_URI=
# Encrypts stored Strava tokens. Generate once and keep it; changing it
# disconnects everyone:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_TOKEN_KEY=

# Optional — fuel coach model and daily caps on paid plan builds.
# COACH_MODEL=claude-opus-5-5
# COACH_DAILY_PER_USER=8
# COACH_DAILY_TOTAL=150
